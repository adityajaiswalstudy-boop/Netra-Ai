  "benchmark_harness": {
    "description": "How to run the benchmark",
    "steps": [
      "1. Load each scenario fixture",
      "2. Call analyze_frame() with the mock Vision response (via MOCK provider or direct mock injection)",
      "3. Compare output perception against expected_perception",
      "4. Pass perception through safety_engine.decide()",
      "5. Compare decision against expected_safety_decision",
      "6. Record pass/fail for each scenario",
      "7. Generate benchmark report with per-scenario details"
    ],
    "metrics": [
      "Perception accuracy: % of scenarios where output matches expected",
      "Object detection rate: % of expected objects detected",
      "Position accuracy: % of objects with correct position",
      "Distance estimate accuracy: average error in estimated_distance_m",
      "Risk classification accuracy: % of objects with correct risk level",
      "Path classification accuracy: % of paths correctly classified",
      "Safety decision accuracy: % of scenarios with correct action",
      "Overall pipeline accuracy: end-to-end correct decisions"
    ],
    "note": "These fixtures represent EXPECTED behavior. Real Vision API results will vary. When a real API key is available, run the same harness against live API responses and compare."
  }
}