{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perception Output",
  "description": "Structured environmental perception from camera frame analysis",
  "type": "object",
  "required": ["scene_summary", "objects", "left_path", "center_path", "right_path", "overall_risk", "confidence"],
  "properties": {
    "scene_summary": {
      "type": "string",
      "description": "Human-readable summary of the scene",
      "minLength": 1,
      "maxLength": 500
    },
    "objects": {
      "type": "array",
      "description": "Detected objects in the scene",
      "items": {
        "type": "object",
        "required": ["type", "position"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["person", "vehicle", "motorcycle", "bicycle", "pole",
              "tree", "wall", "stairs", "pothole", "construction_barrier",
              "bench", "bin", "sign", "door", "fence", "road", "sidewalk",
              "crossing", "curb", "unknown_obstacle", "animal"]
          },
          "position": {
            "type": "string",
            "enum": ["left", "center", "right", "left_far", "center_far",
              "right_far", "background"]
          },
          "estimated_distance_m": {
            "type": ["number", "null"],
            "description": "Estimated distance in meters (monocular, not exact)",
            "minimum": 0,
            "maximum": 50
          },
          "distance_confidence": {
            "type": "number",
            "description": "Confidence in distance estimate",
            "minimum": 0,
            "maximum": 1
          },
          "blocks_path": {
            "type": "boolean",
            "description": "Whether this object blocks the path"
          },
          "risk": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]
          }
        }
      }
    },
    "left_path": {
      "type": "object",
      "required": ["clear", "risk", "confidence"],
      "properties": {
        "clear": { "type": "boolean" },
        "risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "center_path": {
      "type": "object",
      "required": ["clear", "risk", "confidence"],
      "properties": {
        "clear": { "type": "boolean" },
        "risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "right_path": {
      "type": "object",
      "required": ["clear", "risk", "confidence"],
      "properties": {
        "clear": { "type": "boolean" },
        "risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "overall_risk": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "confidence": {
      "type": "number",
      "description": "Overall perception confidence",
      "minimum": 0,
      "maximum": 1
    },
    "frame_timestamp_ms": {
      "type": "number",
      "description": "Timestamp of the captured frame"
    },
    "debug": {
      "type": "object",
      "description": "Optional debug info (not for production)",
      "properties": {
        "model_used": { "type": "string" },
        "processing_time_ms": { "type": "number" },
        "raw_model_output": { "type": "string" }
      }
    }
  }
}
