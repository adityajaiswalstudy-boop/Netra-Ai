.env.example — copy to .env and fill in. NEVER commit .env with real values.

# =============================================================================
# GOOGLE MAPS PLATFORM — Routes API (v2, GA)
# =============================================================================
# Enable: Routes API in Google Cloud Console
# Get API key: Credentials → Create credentials → API key
# Restrict key to Routes API only
# Documentation:
#   https://developers.google.com/maps/documentation/routes
#   Endpoint: POST https://routes.googleapis.com/directions/v2:computeRoutes
#   Auth: X-Goog-Api-Key header (NOT query parameter)
#   Field mask: X-Goog-FieldMask header (required)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =============================================================================
# GOOGLE CLOUD TEXT-TO-SPEECH
# =============================================================================
# Enable: Cloud Text-to-Speech API in Google Cloud Console
# Create service account with Cloud Text-to-Speech API User role
# Download JSON key or use API key
# Documentation:
#   https://cloud.google.com/text-to-speech/docs
#   Endpoint: POST https://text-to-speech.googleapis.com/v1/text:synthesize
#   Auth: OAuth2 Bearer token (service account) or API key
GOOGLE_TTS_PROJECT_ID=your_gcp_project_id

# =============================================================================
# VISION AI MODEL
# =============================================================================
# Options:
#   - google_vision: Cloud Vision API label + object detection
#   - gpt4v: GPT-4V (OpenAI) multimodal
#   - claude: Claude (Anthropic) multimodal
#   - gemini: Google Gemini multimodal
# Documentation:
#   Vision API: https://cloud.google.com/vision/docs
#   GPT-4V: https://platform.openai.com/docs/vision
#   Claude: https://docs.anthropic.com/claude/docs
VISION_PROVIDER=google_vision
VISION_API_KEY=your_vision_api_key_here

# =============================================================================
# N8N WEBHOOK
# =============================================================================
# Your n8n Cloud workspace webhook base URL
# Example: https://your-workspace.app.n8n.cloud/webhook
N8N_WEBHOOK_BASE=https://your-workspace.app.n8n.cloud/webhook
N8N_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# SERVER (local dev)
# =============================================================================
SERVER_HOST=localhost
SERVER_PORT=8080
DEBUG=false
